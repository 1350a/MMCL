{
  "name": "@mcl/host",
  "version": "0.1.0",
  "private": true,
  "description": "MCL 组件宿主（ComponentHost）：manifest 能力声明 + 宿主强制授予 + 协效应重评估 + 卸载回滚（DESIGN.md §5.3）。纯 TS，不依赖 Electron。",
  "license": "ISC",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@mcl/agent": "workspace:*",
    "@types/node": "^22.9.0",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
